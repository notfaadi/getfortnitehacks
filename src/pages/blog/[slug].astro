---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { IntelBlogPostPage } from '../../views/IntelBlogPostPage'
import { INTEL_BLOGS, getIntelBlog, intelBlogPath } from '../../data/intel-blog'
import { SITE_URL, type PageSeo } from '../../data/site'

export function getStaticPaths() {
  return INTEL_BLOGS.map((post) => ({ params: { slug: post.slug } }))
}

const { slug } = Astro.params
const post = getIntelBlog(slug!)

if (!post) {
  return Astro.redirect('/404')
}

const path = intelBlogPath(post.slug)
const seo: PageSeo = {
  title: post.metaTitle,
  description: post.metaDescription,
  path,
  ogType: 'article',
  robots: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
}

const jsonLdExtra = [
  {
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.metaDescription,
    datePublished: post.date,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog` },
      { '@type': 'ListItem', position: 3, name: post.title, item: `${SITE_URL}${path}` },
    ],
  },
]
---

<BaseLayout seo={seo} jsonLdExtra={jsonLdExtra}>
  <IntelBlogPostPage client:visible slug={post.slug} />
</BaseLayout>
