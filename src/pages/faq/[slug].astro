---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { SeoContentPage } from '../../views/SeoContentPage'
import { FAQ_ARTICLES, faqArticlePath, getFaqArticle } from '../../data/seo-faq-articles'
import { SITE_URL, type PageSeo } from '../../data/site'

export function getStaticPaths() {
  return FAQ_ARTICLES.map((a) => ({ params: { slug: a.slug } }))
}

const { slug } = Astro.params
const article = getFaqArticle(slug!)

if (!article) {
  return Astro.redirect('/404')
}

const path = faqArticlePath(article.slug)
const seo: PageSeo = {
  title: article.title,
  description: article.description,
  path,
  ogType: 'website',
  robots: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
}

const jsonLdExtra = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'FAQ', item: `${SITE_URL}/faq` },
      { '@type': 'ListItem', position: 3, name: article.h1, item: `${SITE_URL}${path}` },
    ],
  },
]
---

<BaseLayout seo={seo} jsonLdExtra={jsonLdExtra}>
  <SeoContentPage
    client:visible
    h1={article.h1}
    intro={article.paragraphs[0] ?? ''}
    sections={[
      {
        heading: 'Answer',
        body: article.paragraphs,
      },
    ]}
    related={[
      { label: 'All FAQ', href: '/faq' },
      { label: 'Pricing', href: '/pricing' },
      { label: 'Support', href: '/support' },
    ]}
    currentPath={path}
    eyebrow="FAQ"
  />
</BaseLayout>
